#!/usr/bin/env bash
# scripts/bin/validate-custom — repo-specific validation, auto-discovered by
# vrg-validate (vergil_tooling.bin.vrg_validate._find_custom_validator looks for
# exactly this path). It runs every step of the CI pins job (`quality / pins`
# in .github/workflows/ci.yml), in the same order, with the same commands and
# working directories, so local validation and CI agree:
#   1. every exact pin in docker/pins/pins.yml is justified (check_pins.py);
#   2. docker/pins/CATALOG.md is up to date (generate_catalog.py --check);
#   3. the docker/pins tooling tests pass (offline, hermetic);
#   4. every generated version list is up to date with docker/versions/manifest.yml;
#   5. the docker/versions tooling tests pass (offline, hermetic).
# Keep this list in step with the pins job: a step added there belongs here too.
# Fail-defer: run everything, report all failures, exit nonzero if any failed.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"
fail=0

run() {
  echo "→ $*"
  "$@" || fail=1
}

# Run a command from a subdirectory (CI's `working-directory:`), recording a
# failure without aborting the remaining checks.
run_in() {
  local dir="$1"
  shift
  (
    cd "${ROOT}/${dir}" || exit 1
    run "$@"
    exit "$fail"
  ) || fail=1
}

run python3 "${ROOT}/docker/pins/check_pins.py"
run python3 "${ROOT}/docker/pins/generate_catalog.py" --check
run_in docker/pins \
  uv run --with pytest --with packaging --with pyyaml python -m pytest -q -p no:cacheprovider
run python3 "${ROOT}/docker/versions/generate.py" --check
run_in docker/versions \
  uv run --with pytest --with pyyaml python -m pytest -q -p no:cacheprovider

exit "$fail"
