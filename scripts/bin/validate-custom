#!/usr/bin/env bash
# scripts/bin/validate-custom — repo-specific validation, auto-discovered by
# vrg-validate (vergil_tooling.bin.vrg_validate._find_custom_validator looks for
# exactly this path). It runs the same version-manifest gates as the CI pins job
# (.github/workflows/ci.yml), so local validation and CI agree:
#   1. every generated version list is up to date with docker/versions/manifest.yml;
#   2. the docker/versions tooling tests pass (offline, hermetic).
# Fail-defer: run everything, report all failures, exit nonzero if any failed.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"
fail=0

run() {
  echo "→ $*"
  "$@" || fail=1
}

run python3 "${ROOT}/docker/versions/generate.py" --check
(
  cd "${ROOT}/docker/versions" &&
    run uv run --with pytest --with pyyaml python -m pytest -q -p no:cacheprovider
  exit "$fail"
) || fail=1

exit "$fail"
