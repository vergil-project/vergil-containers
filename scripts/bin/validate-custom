#!/usr/bin/env bash
# scripts/bin/validate-custom — repo-specific validation, auto-discovered by
# vrg-validate (vergil_tooling.bin.vrg_validate._find_custom_validator looks for
# exactly this path). It runs the repo's pins, versions, Trivy-gate and hadolint
# checks; PR CI runs it as `quality / custom` (the custom job in vergil-actions
# ci-quality.yml, via `vrg-validate --check custom`), so local validation and
# CI run the same checks:
#   1. every exact pin in docker/pins/pins.yml is justified (check_pins.py);
#   2. docker/pins/CATALOG.md is up to date (generate_catalog.py --check);
#   3. the docker/pins tooling tests pass (offline, hermetic — every test
#      injects its fetch/probe; an unrun suite once rotted silently, #574);
#   4. every generated version list (publish matrix, build.sh, package cleanup,
#      Dockerfile ARG defaults, docs tables, window.json) is up to date with
#      docker/versions/manifest.yml (epic vergil-project/.github#407);
#   5. the docker/versions tooling tests pass (offline, hermetic);
#   6. the publish pipeline's Trivy scan and gate scripts pass their tests
#      (scripts/tests/trivy.test.sh; a stubbed docker, offline, #721);
#   7. hadolint passes on every generated Dockerfile, linted as CI's
#      `quality / hadolint` job lints them (#761): docker/generate.sh expands
#      the templates (the Dockerfiles are gitignored build output), then
#      hadolint lints docker/*/Dockerfile with the repo's .hadolint.yaml.
# Fail-defer: run everything, report all failures, exit nonzero if any failed.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"
fail=0

run() {
  echo "→ $*"
  "$@" || fail=1
}

# Run a command from a subdirectory (CI's `working-directory:`), recording a
# failure without aborting the remaining checks.
run_in() {
  local dir="$1"
  shift
  (
    cd "${ROOT}/${dir}" || exit 1
    run "$@"
    exit "$fail"
  ) || fail=1
}

run uv run "${ROOT}/docker/pins/check_pins.py"
run uv run "${ROOT}/docker/pins/generate_catalog.py" --check
run_in docker/pins \
  uv run --with pytest --with packaging --with pyyaml python -m pytest -q -p no:cacheprovider
run uv run "${ROOT}/docker/versions/generate.py" --check
run_in docker/versions \
  uv run --with pytest --with pyyaml python -m pytest -q -p no:cacheprovider
run bash "${ROOT}/scripts/tests/trivy.test.sh"

# Lint only what this run generated: if generation fails, a stale Dockerfile
# left by an earlier run must not be linted as though it were current.
echo "→ bash ${ROOT}/docker/generate.sh"
if bash "${ROOT}/docker/generate.sh"; then
  run_in . hadolint --config .hadolint.yaml "${ROOT}"/docker/*/Dockerfile
else
  fail=1
fi

exit "$fail"
