ARG GO_VERSION=1.25
FROM golang:${GO_VERSION}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- System packages ---------------------------------------------------------
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      git jq openssh-client xz-utils gnupg ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# @include common/path-defaults.dockerfile
# @include common/node-markdownlint.dockerfile
# @include common/github-cli.dockerfile
# @include common/validation-tools.dockerfile
# @include common/python-support.dockerfile
# @include common/nfpm.dockerfile
# @include common/pandoc.dockerfile

# --- Go tools ----------------------------------------------------------------
# The image builds with GOTOOLCHAIN=local, so the toolchain cannot fetch a newer
# Go to satisfy a tool's `go` directive: an unpinned @latest whose go.mod needs
# a newer Go than the image ships fails the build outright. A tool whose newest
# release has outgrown an image's Go is version-selected for that image only,
# to the newest release that still declares a Go it can build with; everywhere
# else it installs @latest. See docker/pins/pins.yml.
#   Go 1.25:
#     golangci-lint     v2.13.0+ needs Go 1.26 -> v2.12.2 (#569)
#     go-test-coverage  v2.18.4+ needs Go 1.26 -> v2.18.3
#     govulncheck       x/vuln v1.8.0+ needs Go 1.26 -> v1.7.0 (#606)
#     goimports         x/tools v0.50.0+ needs Go 1.26 -> v0.49.0 (#606)
#   Go 1.26:
#     go-test-coverage  v2.20.0+ needs Go 1.27 -> v2.19.0 (#606)
# A tool returns to @latest on an image as soon as nothing constrains it there;
# holding an unconstrained branch at a hand-written version is drift, not
# policy (#571).
RUN GTC_VERSION="latest" && \
    GOLANGCI_LINT_VERSION="latest" && \
    GOVULNCHECK_VERSION="latest" && \
    GOIMPORTS_VERSION="latest" && \
    case "$(go env GOVERSION)" in \
      go1.25*) GTC_VERSION="v2.18.3"; GOLANGCI_LINT_VERSION="v2.12.2"; \
               GOVULNCHECK_VERSION="v1.7.0"; GOIMPORTS_VERSION="v0.49.0" ;; \
      go1.26*) GTC_VERSION="v2.19.0" ;; \
    esac && \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@"${GOLANGCI_LINT_VERSION}" && \
    go install golang.org/x/vuln/cmd/govulncheck@"${GOVULNCHECK_VERSION}" && \
    go install github.com/google/go-licenses/v2@latest && \
    go install github.com/fzipp/gocyclo/cmd/gocyclo@latest && \
    go install golang.org/x/tools/cmd/goimports@"${GOIMPORTS_VERSION}" && \
    go install github.com/vladopajic/go-test-coverage/v2@"${GTC_VERSION}"

WORKDIR /workspace
