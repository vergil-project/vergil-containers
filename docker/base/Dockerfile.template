# Generated from Dockerfile.template — DO NOT EDIT the Dockerfile directly.
# Canonical source: https://github.com/vergil-project/vergil-containers
# dev-base — Base dev container with all common tooling, built on the package
# toolchain image for Ubuntu 24.04 (epic vergil-project/.github#649, spec
# §5.2). Language-specific images extend this with runtime and
# language-specific tools.
#
# The parent comes from docker/versions/manifest.yml (`base: parent:`):
# docker/build.sh and the publish workflow pass it as PARENT_IMAGE. uv and nFPM
# come from it. base adds the core runtimes its own tools run on, side by side
# under /opt/vergil/ (spec §5.2.1): vergil-python from the vergil apt repository
# and a nodejs.org Node. Their series come from the manifest's `core:` section as
# the CORE_* build args generate.py emits. base puts no node, npm, npx or pip on
# PATH, and pip-installs nothing.
ARG PARENT_IMAGE
FROM ${PARENT_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- No package toolchain marker ---------------------------------------------
# The parent marks itself a package toolchain image; base and every image built
# on it is not one (spec §5.2). checks-invariants.sh asserts it stays absent.
RUN rm -f /etc/vergil/package-toolchain

# --- Core series -------------------------------------------------------------
# Persisted for the images built on base, since a build ARG does not carry into
# a child image: checks-invariants.sh and checks-defaults.sh read these.
ARG CORE_PYTHON
ARG CORE_NODE_MAJOR
ENV VERGIL_CORE_PYTHON=${CORE_PYTHON} \
    VERGIL_CORE_NODE_MAJOR=${CORE_NODE_MAJOR}

# Build-time only: apt never prompts. An ARG, so it is not set in the image.
ARG DEBIAN_FRONTEND=noninteractive

# --- System packages ---------------------------------------------------------
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      git curl jq openssh-client xz-utils gnupg ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# @include common/vergil-apt.dockerfile
# @include common/core-python.dockerfile
# @include common/path-defaults.dockerfile
# @include common/core-node.dockerfile
# @include common/github-cli.dockerfile
# @include common/validation-tools.dockerfile
# @include common/security-tools.dockerfile
# @include common/opentofu.dockerfile
# @include common/rpm.dockerfile
# @include common/pandoc.dockerfile
# @include common/core-tools.dockerfile

# --- Build-time checks -------------------------------------------------------
# The invariants every image built on base keeps, and base's defaults, which a
# language image may change; both stay in the image for its children to rerun.
# checks.sh (every invariant and every default) runs here from the build
# context and is not kept. Any failure fails the build.
COPY checks-invariants.sh checks-defaults.sh /usr/local/lib/vergil/checks/
RUN --mount=type=bind,source=checks.sh,target=/tmp/vergil-checks.sh \
    bash /tmp/vergil-checks.sh

EXPOSE 8000

WORKDIR /workspace
