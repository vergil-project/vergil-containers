# dev-ts-node — TypeScript dev image, Node.js runtime family, built on base
# (epic vergil-project/.github#649, spec §5.3).
#
# The parent comes from docker/versions/manifest.yml (`ts-node: parent:`):
# docker/build.sh and the publish workflow pass it as PARENT_IMAGE. base brings
# every common tool, the core Python and the core Node that markdownlint runs on
# (/opt/vergil/node/<core-major>); this image adds the family's own Node beside
# them, never in their place (spec §5.2.1).
#
# The family Node is the nodejs.org prebuilt tarball for NODE_MAJOR, the
# runtime-major matrix axis: never built from source (epic
# vergil-project/.github#284 §3.5). Its release and the SHA-256 of each
# architecture's tarball are pinned in docker/pins/toolchains.yml, which
# generate.py emits as the TOOLCHAIN_* build args. The shared, runtime-agnostic
# TypeScript analysis toolset is composed in via common/typescript-analysis.
ARG PARENT_IMAGE
FROM ${PARENT_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build-time only: apt never prompts. An ARG, so it is not set in the image.
ARG DEBIAN_FRONTEND=noninteractive

# --- System packages ---------------------------------------------------------
# pkg-config, for native addons a consumer's npm install builds; base has the
# rest of today's list.
RUN apt-get update && \
    apt-get install -y --no-install-recommends pkg-config && \
    rm -rf /var/lib/apt/lists/*

# --- Node.js runtime (prebuilt, nodejs.org) ----------------------------------
# The pinned tarball for TARGETARCH is downloaded, checked against its pinned
# SHA-256 and unpacked at /opt/node/<NODE_MAJOR>; a missing build arg, a release
# outside the major or a hash mismatch fails the build. node, npm and npx link
# into /usr/local/bin, so this Node is the image's default. npm's global prefix
# is /usr (the npmrc the tarball's npm reads), so `npm root -g` stays
# /usr/lib/node_modules and global bins land in /usr/bin, as consumers expect
# (spec §5.3, §5.5).
#
# The bundled npm is the runtime's and is never upgraded in place (spec §5.8):
# a finding in it is fixed by moving this major's pin, and until a fixed release
# exists it is a .trivyignore entry. markdownlint stays base's wrapper on the
# core Node.
ARG TARGETARCH
ARG NODE_MAJOR=24
ARG TOOLCHAIN_VERSION
ARG TOOLCHAIN_SHA256_AMD64
ARG TOOLCHAIN_SHA256_ARM64
RUN : "${NODE_MAJOR:?ts-node: the NODE_MAJOR build arg is not set}" && \
    : "${TOOLCHAIN_VERSION:?ts-node: the TOOLCHAIN_VERSION build arg is not set}" && \
    : "${TOOLCHAIN_SHA256_AMD64:?ts-node: the TOOLCHAIN_SHA256_AMD64 build arg is not set}" && \
    : "${TOOLCHAIN_SHA256_ARM64:?ts-node: the TOOLCHAIN_SHA256_ARM64 build arg is not set}" && \
    case "${TOOLCHAIN_VERSION}" in \
      "${NODE_MAJOR}".*) ;; \
      *) echo "ts-node: TOOLCHAIN_VERSION ${TOOLCHAIN_VERSION} is not a release of Node ${NODE_MAJOR}" >&2; exit 1 ;; \
    esac && \
    case "${TARGETARCH}" in \
      amd64) node_arch=x64; sha256="${TOOLCHAIN_SHA256_AMD64}" ;; \
      arm64) node_arch=arm64; sha256="${TOOLCHAIN_SHA256_ARM64}" ;; \
      *) echo "ts-node: unsupported TARGETARCH '${TARGETARCH}'" >&2; exit 1 ;; \
    esac && \
    node_dir="/opt/node/${NODE_MAJOR}" && \
    tarball="node-v${TOOLCHAIN_VERSION}-linux-${node_arch}.tar.gz" && \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
      "https://nodejs.org/dist/v${TOOLCHAIN_VERSION}/${tarball}" -o "/tmp/${tarball}" && \
    echo "${sha256}  /tmp/${tarball}" | sha256sum -c - && \
    mkdir -p "${node_dir}" && \
    tar -xzf "/tmp/${tarball}" --strip-components=1 --no-same-owner -C "${node_dir}" && \
    rm "/tmp/${tarball}" && \
    mkdir -p "${node_dir}/etc" && \
    echo 'prefix=/usr' > "${node_dir}/etc/npmrc" && \
    for cmd in node npm npx; do ln -s "${node_dir}/bin/${cmd}" "/usr/local/bin/${cmd}"; done && \
    got="$(node --version)" && \
    if [ "${got}" != "v${TOOLCHAIN_VERSION}" ]; then echo "ts-node: node is ${got}, want v${TOOLCHAIN_VERSION}" >&2; exit 1; fi && \
    got="$(npm root -g)" && \
    if [ "${got}" != /usr/lib/node_modules ]; then echo "ts-node: npm root -g is ${got}, want /usr/lib/node_modules" >&2; exit 1; fi

# @include common/typescript-analysis.dockerfile

# --- Build-time checks -------------------------------------------------------
# base's invariants, the base defaults this image keeps, and the family's own
# checks (checks.sh). It runs from the build context and is not kept. Any
# failure fails the build.
RUN --mount=type=bind,source=checks.sh,target=/tmp/vergil-checks.sh \
    bash /tmp/vergil-checks.sh

WORKDIR /workspace
